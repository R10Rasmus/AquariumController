@using InfoPages.Models
@model Graph

@{
    ViewBag.Title = "Temperature";
}

<!DOCTYPE HTML>
<html>
<head>

    <script>
        var dps = [];
        var chart

        window.onload = function () {

            chart = new CanvasJS.Chart("chartContainer", {
            theme: "light2", // "light1", "light2", "dark1", "dark2"
            animationEnabled: true,
            zoomEnabled: true,
            title: {
                text: "Temperature"
            },
            toolTip: {
                contentFormatter: function (e) {
                    var content = "";
                    for (var i = 0; i < e.entries.length; i++) {
                        content = CanvasJS.formatDate(e.entries[i].dataPoint.x, "HH:mm DD/MM/YYYY") + " " + e.entries[i].dataPoint.y + "C";
                    }
                    return content;
                }
            },
            axisX: {
                valueFormatString: "DD-MM-YY HH:mm",
                labelAngle: -50
            },
                axisY: {
                stripLines: [
                    {
                        value: @Model.Max,
                        color: "red"
                    }, {
                        value: @Model.Min,
                        color: "red"
                        }],
                    minimum: @(Model.Min - 1),
                    maximum:@(Model.Max + 1),
                    valueFormatString: "##.0"
            },
            data: [{
                type: "line",
                xValueType: "dateTime",
                dataPoints: dps,

            }]
              });

            loadData(@((int) Model.TimeSpan));

        }

        function loadData(timeSpan) {
            $.when(
                $.getJSON("/home/TemperatureData?timeSpan=" + timeSpan),
                $.getJSON("/home/EventsData?timeSpan=" + timeSpan)
            ).done(function (temperatureResult, eventsResult) {
                addData(temperatureResult[0], eventsResult[0]);
            });
        }

        function addData(data, events) {
            dps.length = 0;
            for (var i = 0; i < data.length; i++) {
                dps.push({
                    x: new Date(data[i].X),
                    y: data[i].Y
                });
            }
            chart.options.axisX.stripLines = toEventStripLines(events);
            chart.render();
        }

        // Show events (fx. AOT runs) as vertical lines on the graph
        function toEventStripLines(events) {
            var stripLines = [];
            for (var i = 0; i < events.length; i++) {
                stripLines.push({
                    value: new Date(events[i].X),
                    label: events[i].Type === "AOT" ? "AOT kørte" : events[i].Type,
                    labelFontColor: "#d9822b",
                    labelPlacement: "outside",
                    color: "#d9822b",
                    lineDashType: "dash",
                    thickness: 1
                });
            }
            return stripLines;
        }

        function callChangefunc(val) {
            loadData(val);
        }

    </script>
</head>
<body>
    <br />
    @Html.DropDownListFor(m => m.TimeSpan,
             new SelectList(Enum.GetValues(typeof(EnumTimeSpan))), new { @onchange = "callChangefunc(this.value)" } )

    <div id="chartContainer" style="height: 370px; width: 100%;"></div>

</body>
</html>                         