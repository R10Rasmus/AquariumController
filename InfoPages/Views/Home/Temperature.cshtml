@using InfoPages.Models
@model Graph

@{
    ViewBag.Title = "Temperature";
}

<!DOCTYPE HTML>
<html>
<head>

    <script>
        var dps = [];
        var chart
        var coolerStripLines = [];

        window.onload = function () {

            chart = new CanvasJS.Chart("chartContainer", {
            theme: "light2", // "light1", "light2", "dark1", "dark2"
            animationEnabled: true,
            zoomEnabled: true,
            title: {
                text: "Temperature"
            },
            toolTip: {
                contentFormatter: function (e) {
                    var content = "";
                    for (var i = 0; i < e.entries.length; i++) {
                        content = CanvasJS.formatDate(e.entries[i].dataPoint.x, "HH:mm DD/MM/YYYY") + " " + e.entries[i].dataPoint.y + "C";
                    }
                    return content;
                }
            },
            axisX: {
                valueFormatString: "DD-MM-YY HH:mm",
                labelAngle: -50,
                stripLines: []
            },
                axisY: {
                stripLines: [
                    {
                        value: @Model.Max,
                        color: "red"
                    }, {
                        value: @Model.Min,
                        color: "red"
                        }],
                    minimum: @(Model.Min - 1),
                    maximum:@(Model.Max + 1),
                    valueFormatString: "##.0"
            },
            data: [{
                type: "line",
                xValueType: "dateTime",
                dataPoints: dps,

            }]
              });

            $.getJSON("/home/TemperatureData?timeSpan=@((int) Model.TimeSpan)", addData);
            loadCoolerEvents(@((int) Model.TimeSpan));

        }

        function addData(data) {
            dps.length = 0;
            for (var i = 0; i < data.length; i++) {
                dps.push({
                    x: new Date(data[i].X),
                    y: data[i].Y
                });
            }
            chart.render();
        }

        function callChangefunc(val) {
            $.getJSON("/home/TemperatureData?timeSpan=" + val, addData);
            loadCoolerEvents(val);
        }

        function loadCoolerEvents(val) {
            $.getJSON("/home/CoolerEventsData?timeSpan=" + val, function (data) {
                coolerStripLines = buildCoolerStripLines(data);
                applyCoolerOverlay();
            });
        }

        function applyCoolerOverlay() {
            var cb = document.getElementById("showCoolerEvents");
            var show = cb ? cb.checked : false;
            chart.options.axisX.stripLines = show ? coolerStripLines : [];
            chart.render();
        }

        // Build shaded regions (on -> off periods) for fan and cooler from the event list.
        function buildCoolerStripLines(events) {
            var lines = [];
            var open = {};
            var colors = { fan: "rgba(0,120,255,0.15)", cooler: "rgba(255,60,60,0.15)" };
            var labels = { fan: "Fan", cooler: "Cooler" };

            for (var i = 0; i < events.length; i++) {
                var ev = events[i];
                var t = new Date(ev.CreatedAt);
                if (ev.State) {
                    if (!open[ev.Channel]) {
                        open[ev.Channel] = t;
                    }
                } else if (open[ev.Channel]) {
                    lines.push(coolerRegion(open[ev.Channel], t, ev.Channel, colors, labels));
                    open[ev.Channel] = null;
                }
            }

            // a period still open at the end is drawn up to "now"
            var now = new Date();
            for (var ch in open) {
                if (open[ch]) {
                    lines.push(coolerRegion(open[ch], now, ch, colors, labels));
                }
            }
            return lines;
        }

        function coolerRegion(start, end, channel, colors, labels) {
            return {
                startValue: start,
                endValue: end,
                color: colors[channel] || "rgba(150,150,150,0.15)",
                label: labels[channel] || channel,
                labelFontColor: "#555",
                labelPlacement: "outside"
            };
        }

    </script>
</head>
<body>
    <br />
    @Html.DropDownListFor(m => m.TimeSpan,
             new SelectList(Enum.GetValues(typeof(EnumTimeSpan))), new { @onchange = "callChangefunc(this.value)" } )

    <label style="font-weight: normal; margin-left: 15px;">
        <input type="checkbox" id="showCoolerEvents" checked onchange="applyCoolerOverlay()" /> Vis fan/cooler på grafen
    </label>

    <div id="chartContainer" style="height: 370px; width: 100%;"></div>

</body>
</html>                         