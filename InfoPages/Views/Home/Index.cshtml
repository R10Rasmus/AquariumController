@using InfoPages.Models
@model DashboardViewModel

@{
    ViewBag.Title = "Dashboard";
}
<head>

    <script>
        window.onload = function () {
            var TemperatureDps = [];

            var temperatureChart = new CanvasJS.Chart("chartTemperatureContainer", {
                theme: "light2",
                animationEnabled: true,
                zoomEnabled: true,
                toolTip: {
                    contentFormatter: function (e) {
                        var content = "";
                        for (var i = 0; i < e.entries.length; i++) {
                            content = CanvasJS.formatDate(e.entries[i].dataPoint.x, "HH:mm DD/MM/YYYY") + " " + e.entries[i].dataPoint.y + "C";
                        }
                        return content;
                    }
                },
                axisX: {
                    valueFormatString: "HH:mm",
                    labelAngle: -50,
                    stripLines: []
                },
                axisY: {
                    stripLines: [
                        {
                            value: @Model.Graph.Max,
                            color: "red"
                        }, {
                            value: @Model.Graph.Min,
                            color: "red"
                        }],
                      minimum: @(Model.Graph.Min - 1),
                      maximum:@(Model.Graph.Max + 1),
                    valueFormatString: "##.0"
                },
                title: {
                    text: "Temperature"
                },
                data: [{
                    type: "line",
                    xValueType: "dateTime",
                    dataPoints: TemperatureDps
                }]
            });

            var coolerStripLines = [];
            var showCoolerEvents = document.getElementById("showCoolerEvents");
            if (showCoolerEvents) {
                showCoolerEvents.addEventListener("change", applyCoolerOverlay);
            }

            $.getJSON("/home/TemperatureData?timeSpan=1", addDataTemperature);
            $.getJSON("/home/CoolerEventsData?timeSpan=1", addCoolerEvents);

            function addDataTemperature(data) {
                for (var i = 0; i < data.length; i++) {
                    TemperatureDps.push({
                        x: new Date(data[i].X),
                        y: data[i].Y
                    });
                }
                temperatureChart.render();
            }

            function addCoolerEvents(data) {
                coolerStripLines = buildCoolerStripLines(data);
                applyCoolerOverlay();
            }

            function applyCoolerOverlay() {
                var show = showCoolerEvents ? showCoolerEvents.checked : false;
                temperatureChart.options.axisX.stripLines = show ? coolerStripLines : [];
                temperatureChart.render();
            }

            // Build shaded regions (on -> off periods) for fan and cooler from the event list.
            function buildCoolerStripLines(events) {
                var lines = [];
                var open = {};
                var colors = { fan: "rgba(0,120,255,0.15)", cooler: "rgba(255,60,60,0.15)" };
                var labels = { fan: "Fan", cooler: "Cooler" };

                for (var i = 0; i < events.length; i++) {
                    var ev = events[i];
                    var t = new Date(ev.CreatedAt);
                    if (ev.State) {
                        if (!open[ev.Channel]) {
                            open[ev.Channel] = t;
                        }
                    } else if (open[ev.Channel]) {
                        lines.push(coolerRegion(open[ev.Channel], t, ev.Channel, colors, labels));
                        open[ev.Channel] = null;
                    }
                }

                // a period still open at the end is drawn up to "now"
                var now = new Date();
                for (var ch in open) {
                    if (open[ch]) {
                        lines.push(coolerRegion(open[ch], now, ch, colors, labels));
                    }
                }
                return lines;
            }

            function coolerRegion(start, end, channel, colors, labels) {
                return {
                    startValue: start,
                    endValue: end,
                    color: colors[channel] || "rgba(150,150,150,0.15)",
                    label: labels[channel] || channel,
                    labelFontColor: "#555",
                    labelPlacement: "outside"
                };
            }
        }
    </script>
</head>

<div class="col-md-12">
    <div class="row" style="margin: 10px 0;">
        <label style="font-weight: normal;">
            <input type="checkbox" id="showCoolerEvents" checked /> Vis fan/cooler på grafen
        </label>
    </div>
    <div class="row">
        <div id="chartTemperatureContainer" style="width:100%;height:410px"></div>
    </div>
    <div class="row">
        <div id="statusContainer" class="col-md-12" style="margin-top: 20px;">
            <h3>Status</h3>
            <div id="fanStatusContainer" class="status-indicator">
                <div id="fanHueStatus" class="status-half"></div>
                <div id="fanStatus" class="status-half"></div>
            </div>
            <div id="coolerStatusContainer" class="status-indicator">
                <div id="coolerHueStatus" class="status-half"></div>
                <div id="coolerStatus" class="status-half"></div>
            </div>
            <div id="pumperStatusContainer" class="status-indicator">
                <div id="pumperHueStatus" class="status-half" style="width: 100%;"></div>
            </div>
        </div>
    </div>
    <div class="row">
        <h3>Pumper - last 5 state changes</h3>
        @if (Model.PumperStateChanges == null || Model.PumperStateChanges.Count == 0)
        {
            <p>No state changes registered yet.</p>
        }
        else
        {
            <table class="table">
                <tr>
                    <th>Time</th>
                    <th>From</th>
                    <th></th>
                    <th>To</th>
                </tr>
                @foreach (var change in Model.PumperStateChanges)
                {
                    <tr>
                        <td>@change.Timestamp.ToString("dd-MM-yyyy HH:mm:ss")</td>
                        <td>@(change.FromState ? "On" : "Off")</td>
                        <td>&rarr;</td>
                        <td>@(change.ToState ? "On" : "Off")</td>
                    </tr>
                }
            </table>
        }
    </div>
</div>

<script>
    $(document).ready(function () {
        $.getJSON("/status/GetStatus", function (data) {
            var fanStatusColor = data.FanCoolerOnOff ? "green" : "red";
            var fanHueStatusColor = data.FanCoolerOnOffHue ? "green" : "red";
            var coolerStatusColor = data.ExtraCoolerOnOff ? "green" : "red";
            var coolerHueStatusColor = data.ExtraCoolerOnOffHue ? "green" : "red";
            var pumperHueStatusColor = data.PumperOnOffHue ? "green" : "red";

            $("#fanStatus").css("background-color", fanStatusColor).text("Fan Status: " + (data.FanCoolerOnOff ? "On" : "Off"));
            $("#fanHueStatus").css("background-color", fanHueStatusColor).text("Fan Hue: " + (data.FanCoolerOnOffHue ? "On" : "Off"));
            $("#coolerStatus").css("background-color", coolerStatusColor).text("Cooler Status: " + (data.ExtraCoolerOnOff ? "On" : "Off"));
            $("#coolerHueStatus").css("background-color", coolerHueStatusColor).text("Cooler Hue: " + (data.ExtraCoolerOnOffHue ? "On" : "Off"));
            $("#pumperHueStatus").css("background-color", pumperHueStatusColor).text("Pumper Hue: " + (data.PumperOnOffHue ? "On" : "Off"));
        });
    });
</script>

<style>
    .status-indicator {
        width: 100%;
        padding: 20px;
        margin: 10px 0;
        color: white;
        text-align: center;
        font-size: 18px;
        overflow: hidden;
    }

    .status-half {
        width: 50%;
        float: left;
        padding: 20px;
        box-sizing: border-box;
    }

    #fanStatusContainer {
        clear: both;
    }

    #coolerStatusContainer {
        clear: both;
    }

    #pumperStatusContainer {
        clear: both;
    }
</style>
